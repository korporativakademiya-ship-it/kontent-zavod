        "jsonBody": "={{ (() => { const s = $('Sahnalarni ajrat').all()[$itemIndex].json; return JSON.stringify({ contents: [{ parts: [{ text: (s.rejissura || 'Brisk, energetic, confident narrator, natural Uzbek pronunciation, no long pauses') + ': ' + s.ovoz_matn }] }], generationConfig: { responseModalities: ['AUDIO'], speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: s.OVOZ } } } } }); })() }}",
