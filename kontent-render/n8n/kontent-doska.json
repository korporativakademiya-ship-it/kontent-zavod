    {
      "id": "53a07957-d621-48a4-8d6f-c2da77175d29",
      "name": "Kiruvchi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ],
      "parameters": {
        "jsCode": "// Guruh topigidagi xabar yoki tugma. Kim yozishi mumkin — foydalanuvchi ID (guruhda boshqalar ham yozadi)\nconst RUXSAT = ['8815205589'];\nconst cb = $json.callback_query;\nconst msg = cb ? cb.message : $json.message;\nconst kim = String((cb ? cb.from : $json.message?.from)?.id || '');\nconst chatId = String(msg?.chat?.id || '');\n// Faqat forum topigi: topiksiz (General) va shaxsiy chatga javob yozilmaydi — javob doim o'sha topikka qaytadi\nconst thread = msg?.message_thread_id && (msg.is_topic_message || cb) ? String(msg.message_thread_id) : '';\nif (!chatId || !thread || (RUXSAT.length && !RUXSAT.includes(kim))) return [];\nconst text = cb ? '' : String($json.message?.text || $json.message?.caption || '').trim();\nif (!cb && !text) return [];\nreturn [{ json: { chatId, thread, text, tugma: cb ? String(cb.data || '') : '', callbackId: cb ? String(cb.id) : '' } }];"
      }
    },
