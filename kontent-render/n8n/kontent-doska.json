    {
      "id": "a831fb8c-c099-4bbd-b9e4-6c8900a8b9a8",
      "name": "Modellar ro'yxati",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        700
      ],
      "parameters": {
        "method": "GET",
        "url": "https://generativelanguage.googleapis.com/v1beta/models?pageSize=1000",
