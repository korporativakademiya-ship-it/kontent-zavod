      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + ($('Sahnalarni ajrat').all()[$itemIndex].json.ovoz_matn.trim() ? $('Sahnalarni ajrat').all()[$itemIndex].json.TTS_MODEL : 'ovoz-yoq') + ':generateContent' }}",
