    {
      "id": "bd66777f-8fb6-44aa-a413-19793cc97a56",
      "name": "Sahnalarni ajrat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        700
      ],
      "parameters": {
        "jsCode": "// Modellar Google ro'yxatidan: nomlar eskirsa ham eng yangisi olinadi\nconst barchasi = ($('Modellar ro\\'yxati').first().json.models || []).map(m => m.name.replace('models/', ''));\nconst ver = n => parseFloat((n.match(/(\\d+(?:\\.\\d+)?)/) || [0, 0])[1]);\nconst eng = (arr) => arr.sort((a, b) => ver(b) - ver(a) || (/flash/.test(b) - /flash/.test(a)))[0] || '';\nconst RASM_MODEL = eng(barchasi.filter(n => /image/i.test(n) && !/imagen/i.test(n)));\nconst TTS_MODEL = eng(barchasi.filter(n => /tts/i.test(n)));\n// Diktor — erkak ovoz. Boshqasini sinash: Puck (jonli), Fenrir, Orus\nconst OVOZ = 'Charon';\nconst ic = $('Suhbat').first().json.keyingi;\n// Kino: rasm kerak emas (shablonlar o'zi chizadi) — faqat har sahna ovozi\nif (ic.tur === 'kino') return (ic.sahnalar || []).map((s, i) => ({ json: { i, s, kino: true, rasm_prompt: '', ovoz_matn: s.ovoz || '', rejissura: s.rejissura || '',\n  RASM_MODEL, TTS_MODEL, OVOZ, jami: ic.sahnalar.length } }));\nconst hammasi = [...(ic.sahnalar || []).map(s => ({ ...s, yakun: false })), { ...(ic.yakun || {}), yakun: true }];\nconst zaxira = 'Abstract soft-focus modern office background, deep blue and violet, gentle bokeh, cinematic, vertical 9:16, no text, no letters, no logos.';\nreturn hammasi.map((s, i) => ({ json: { i, s, rasm_prompt: s.rasm_prompt || zaxira, ovoz_matn: s.ovoz || '', rejissura: s.ovoz_rejissura || '',\n  RASM_MODEL, TTS_MODEL, OVOZ, jami: hammasi.length } }));"
      }
    },
    {
      "id": "8cb51786-f5f9-4388-8e8e-96f89b26b04b",
      "name": "Nano Banana: sahnalar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        700
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://generativelanguage.googleapis.com/v1beta/models/' + ($json.rasm_prompt ? $json.RASM_MODEL : 'rasm-yoq') + ':generateContent' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.rasm_prompt }] }], generationConfig: { responseModalities: ['IMAGE'], imageConfig: { aspectRatio: '9:16' } } }) }}",
        "options": {
          "timeout": 180000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2500
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
