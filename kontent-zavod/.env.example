# Telegram
BOT_TOKEN=
ADMIN_IDS=              # vergul bilan: 111,222
GROUP_ID=               # virtual ofis guruhi (/id)
APPROVAL_TOPIC_ID=      # "Tasdiqlash" topigi (/id)
LOG_TOPIC_ID=           # "Jarayon" topigi (/id)
CHANNEL_ID=             # @kanal yoki -100...

# Claude: api | max
LLM_MODE=api
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
CLAUDE_CODE_OAUTH_TOKEN=   # max rejimi uchun (claude setup-token)
