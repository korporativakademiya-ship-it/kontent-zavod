# Telegram
BOT_TOKEN=
ADMIN_IDS=              # vergul bilan: 111,222
# ADMIN_IDS_QOSHIMCHA=   # qo'shimcha rahbarlar (vergul bilan) — ADMIN_IDS ni o'zgartirmasdan
GROUP_ID=               # virtual ofis guruhi (/id)
APPROVAL_TOPIC_ID=      # "Tasdiqlash" topigi (/id)
LOG_TOPIC_ID=           # "Jarayon" topigi (/id)
CHANNEL_ID=             # @kanal yoki -100...
# PRODUCT_TOPICS=ka:867,qa:869,kf:871   # mahsulot rejimi: har mahsulot ofis guruhidagi o'z topigida (kod:topik_id)
# TELEGRAM_API_ROOT=     # ixtiyoriy: lokal Bot API server (standart https://api.telegram.org)

# Claude: api | max
LLM_MODE=api
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5          # arzonroq: claude-sonnet-5-5
CLAUDE_CODE_OAUTH_TOKEN=   # max rejimi uchun (claude setup-token)
MAX_MODEL=sonnet
# Bitta Claude chaqiruviga vaqt chegarasi (daqiqa). Qotib qolsa bekor qilinadi, zavod to'xtab qolmaydi
LLM_VAQT_MIN=15

# Jadval
DAILY_CRON=0 8 * * *
DAILY_POSTS=3
POST_TIMES=09:00,19:00
DATA_DIR=./data         # Railway'da: volume ulang (/data) va DATA_DIR=/data — aks holda har deployda baza o'chadi
# ESKI_SOAT=6           # vaqti shuncha soatdan ko'p o'tib ketgan post (bot o'chiq turgan) chiqmaydi — navbatdan olinadi
# BACKUP_CRON=15 3 * * *   # kunlik zaxira vaqti (Toshkent) — egasiga shaxsiy chatda

# Video (reels)
VIDEO_FPS=30
# AVTO_VIDEO=0           # rejadagi reels uchun video o'zi yasalmasin (standart: yasaladi)
# AVTO_RASM=0            # prodyuser rasm so'rasa ham rasm qo'yilmasin. Standart: GEMINI_API_KEY bo'lsa — AI rasm,
#                         # bo'lmasa — Claude dizayner kartochkasi (kalit kerak emas)
# PRODYUSER=0            # rejadagi postlar prodyuser TZ siz yozilsin
# CHROMIUM_PATH=         # ixtiyoriy: Chromium yo'li (Docker'da kerak emas)
# FFMPEG_PATH=           # ixtiyoriy: tizimdagi ffmpeg (standart: ffmpeg-static paketi)

# Ovoz (dublyaj va audio variant) — bittasini tanlang, bo'sh bo'lsa ovoz o'chiq
TTS_PROVIDER=             # gemini | azure | elevenlabs
GEMINI_API_KEY=           # gemini: n8n doskadagi kalit bilan bir xil
GEMINI_VOICE=Charon       # erkak diktor (yana: Puck, Fenrir, Orus)
# GEMINI_TTS_MODEL=       # bo'sh — eng yangi TTS modeli o'zi tanlanadi
# GEMINI_IMAGE_MODEL=     # AI rasm (🖼 → ai): bo'sh — eng yangi rasm modeli; GEMINI_API_KEY bo'lsa yoqiladi
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=uz-UZ-SardorNeural   # yoki uz-UZ-MadinaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=      # o'z ovozingiz klonlangan bo'lsa — uning ID si
ELEVENLABS_MODEL=eleven_v3

# Haftalik hisobot vaqti (dushanba 09:00)
REPORT_CRON=0 9 * * 1

# Haftalik reja: tuzilish vaqti (yakshanba 18:00) va reja kunlari (0=Ya, 1=Du ... 6=Sha)
PLAN_CRON=0 18 * * 0
PLAN_DAYS=1,2,3,4,5,6

# Fakt tekshiruvi (raqam va da'volarni internetdan tekshirish). O'chirish: 0
FACT_CHECK=1

# Kotibim CRM'dagi "Kontent kalendar" bilan sinxron (ixtiyoriy)
KOTIBIM_URL=              # masalan https://kotibim.up.railway.app
KONTENT_API_KALIT=        # Kotibim'dagi KONTENT_API_KALIT bilan bir xil

# n8n doska uchun API (reels liniyasi). Bo'sh bo'lsa API so'rovlari rad etiladi (503); /api/health ochiq
N8N_API_KALIT=            # uzun tasodifiy satr (kamida 32 belgi)
# PORT=8080
# Uslubni o'rganish uchun rahbarning kanali (t.me/s/<nom>)
USLUB_KANAL=

# Instagram profillarini kuzatish (g'oya ovchisi). Meta Business Discovery API — o'z Instagram biznes akkauntingiz ID'si va token
IG_ACCESS_TOKEN=
IG_USER_ID=
# GRAPH_API_VERSION=v21.0

# Kino video (kontent-render servisi, shu repodagi kontent-render/): grid / doska / plakat / chat shablonlari + ovoz + musiqa.
# Berilsa, 🎥 Video va rejadagi reels shu orqali yasaladi (n8n kerak emas); bo'sh — ichki oddiy shablon
KONTENT_RENDER_URL=       # http://kontent-render.railway.internal:8080
KINO_NIK=                 # videodagi imzo, masalan @pulatovjurabek
# KINO=0                  # n8n doskada kino rejissyorini o'chirish (eski AI rasm slayd-shou yo'li)

# HeyGen avatar video (o'z avataringiz o'qiydi). VIDEO_TURI=avatar bo'lsa 🎥 va reels shu orqali; boshqa qiymat — kino/oddiy
VIDEO_TURI=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=          # HeyGen'dagi ovoz (klonlangan ovozingiz ham)

# Avto rejimni Telegram'siz yoqish: on | off (har qiymat bir marta qo'llanadi, keyin /avto bilan o'zgartiriladi)
AVTO_REJIM=
