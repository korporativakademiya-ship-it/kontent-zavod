# Telegram
BOT_TOKEN=
ADMIN_IDS=              # vergul bilan: 111,222
GROUP_ID=               # virtual ofis guruhi (/id)
APPROVAL_TOPIC_ID=      # "Tasdiqlash" topigi (/id)
LOG_TOPIC_ID=           # "Jarayon" topigi (/id)
CHANNEL_ID=             # @kanal yoki -100...

# Claude: api | max
LLM_MODE=api
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
CLAUDE_CODE_OAUTH_TOKEN=   # max rejimi uchun (claude setup-token)
MAX_MODEL=sonnet

# Jadval
DAILY_CRON=0 8 * * *
DAILY_POSTS=3
POST_TIMES=09:00,19:00
DATA_DIR=./data

# Video (reels)
VIDEO_FPS=30
# CHROMIUM_PATH=         # ixtiyoriy: Chromium yo'li (Docker'da kerak emas)
# FFMPEG_PATH=           # ixtiyoriy: tizimdagi ffmpeg (standart: ffmpeg-static paketi)

# Ovoz (dublyaj va audio variant) — bittasini tanlang, bo'sh bo'lsa ovoz o'chiq
TTS_PROVIDER=             # azure | elevenlabs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_VOICE=uz-UZ-SardorNeural   # yoki uz-UZ-MadinaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=      # o'z ovozingiz klonlangan bo'lsa — uning ID si
ELEVENLABS_MODEL=eleven_v3
